rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['vishvajitpawar78@gmail.com', 'vishvajitpawar02@gmail.com'] ||
        (request.auth.uid != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Coupons
    match /coupons/{couponCode} {
      allow read, write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Users profile & addresses
    match /users/{userId} {
      allow read, write: if true;
    }

    // Carts
    match /carts/{userId} {
      allow read, write: if true;
    }

    // Wishlists
    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // Technical Q&A
    match /questions/{questionId} {
      allow read, write: if true;
    }

    // Returns & Refunds
    match /returns/{returnId} {
      allow read, write: if true;
    }

    // Sellers Marketplace Profiles
    match /sellers/{sellerId} {
      allow read, write: if true;
    }

    // User Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Support Tickets
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // Payment Transactions & Gateway Audits
    match /payment_transactions/{txnId} {
      allow read, write: if true;
    }

    // Shipments & Courier Fulfillment
    match /shipments/{shipmentId} {
      allow read, write: if true;
    }

    // Inventory Logs & Stock Adjustments
    match /inventory_logs/{logId} {
      allow read, write: if true;
    }

    // Shipping & Warehouse Configuration
    match /shipping_config/{configId} {
      allow read, write: if true;
    }

    // Saved Curations / Fashion Canvas
    match /saved_curations/{curationId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
