# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://nova.vishvajitpawar02.workers.dev"

# Razorpay Payment Gateway Configuration
# Get your Key ID and Secret from Razorpay Dashboard (Settings -> API Keys)
# In Test Mode: starts with rzp_test_...
# In Live Mode: starts with rzp_live_...
RAZORPAY_KEY_ID="rzp_live_TWNW4QLaIecxI5"
RAZORPAY_KEY_SECRET="HP02MHqrsfbaWNza1GXQn3r5"
RAZORPAY_WEBHOOK_SECRET="Phondaghat123"

# Payment Feature Flags
ENABLE_INTERNATIONAL_PAYMENTS="true"
DEFAULT_CURRENCY="INR"

# Shipping & Logistics Provider Configuration
# Supported providers: "manual" (default with full operational integrity), "shiprocket", "delhivery"
SHIPPING_PROVIDER="manual"
# Shiprocket API Credentials (optional for API-connected mode)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_API_TOKEN=""
# Delhivery API Credentials (optional for API-connected mode)
DELHIVERY_API_TOKEN=""
# Courier Webhook Secret for real-time tracking status synchronization
SHIPPING_WEBHOOK_SECRET=""

